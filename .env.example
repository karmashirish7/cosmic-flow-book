# Copy to .env for local builds. Never commit real values.
# Anything prefixed VITE_ is bundled into public browser JavaScript — no secrets there.

OPENROUTER_API_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Akashvani API (Kundli page) — NOT set here. These are Cloudflare secrets on the
# cosmic-flow-book Worker: AKASHVANI_API_URL and AKASHVANI_API_KEY.
# For local `npx wrangler dev`, put them in .dev.vars (git-ignored):
#   AKASHVANI_API_URL=https://your-akashvani-api.workers.dev
#   AKASHVANI_API_KEY=...
